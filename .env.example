# Next.js / ScamShield
# Copy to .env.local and fill in values.

# OpenAI (required for /api/analyze)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: URL threat checks in /api/validate-entity (url kind)
# Google Cloud Web Risk — https://cloud.google.com/web-risk
GOOGLE_WEB_RISK_API_KEY=
# PhishTank — https://phishtank.com/api_register.php (higher limits with key)
PHISHTANK_APP_KEY=

# Clerk (required for auth and billing)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe (required for Pro checkout and webhook)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# App URL (for Stripe redirects; optional, defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
