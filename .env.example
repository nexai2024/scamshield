# Next.js / ScamShield
# Copy to .env.local and fill in values.

# OpenAI (required for /api/analyze)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: URL threat checks in /api/validate-entity (url kind)
# Google Cloud Web Risk — https://cloud.google.com/web-risk
GOOGLE_WEB_RISK_API_KEY=
# PhishTank — https://phishtank.com/api_register.php (higher limits with key)
PHISHTANK_APP_KEY=

# Clerk (required for auth and billing)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe (required for Pro checkout and webhook)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# App URL (for Stripe redirects; optional, defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email → report (optional) ---
# Public address shown on the Scanner (e.g. analyze@inbound.yourdomain.com)
NEXT_PUBLIC_INBOUND_EMAIL=
# Shared secret: append ?secret=VALUE to the webhook URL or send Authorization: Bearer VALUE
INBOUND_EMAIL_WEBHOOK_SECRET=
# Upstash Redis — store report payloads for /report/[token] (prod). Dev falls back to in-memory.
# Same Redis powers distributed API rate limits (sliding window). Without it, limits are in-memory per instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to "true" to disable API rate limits (e.g. local stress tests only — never in production).
# RATE_LIMIT_DISABLED=
# Resend — send “report ready” email back to the sender
RESEND_API_KEY=
# Verified sender in Resend (e.g. ScamShield <reports@yourdomain.com> or Resend onboarding address)
INBOUND_REPLY_FROM=
